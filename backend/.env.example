APP_NAME=Esalud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: usar la IP de tu red interna, ej. http://192.168.1.144:8080
# Produccion: usar el dominio real, ej. https://atenea.cormudesi.cl
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Instrumentacion de diagnostico de memoria del pipeline de carga REM
# (App\Support\MemoryProbe). Debe quedar en false en producción; activar
# solo puntualmente para diagnosticar un problema de memoria.
MEMORY_PROBE_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esalud_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true por politica ATHENEA: la sesion no debe sobrevivir al cierre
# completo del navegador ("recordar sesion" fue eliminado por completo).
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# false mientras se sirva por HTTP (local, o produccion sin TLS todavia).
# Cambiar a true solo cuando el entorno sirva por HTTPS -- con true sobre
# HTTP el navegador descarta la cookie de sesion en silencio.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Local: agregar tu IP de red interna si vas a acceder desde otros
# dispositivos de la LAN, ej. 192.168.1.144:5173,localhost:5173,127.0.0.1:5173
# Produccion: el dominio real, ej. atenea.cormudesi.cl
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
