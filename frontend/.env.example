# URL base de la API Laravel. Relativa (/api/v1) funciona tanto en local
# como en produccion: el dev server de Vite (ver vite.config.ts) hace
# proxy de /api/v1 y /sanctum hacia el backend, y en produccion Nginx
# hace lo mismo bajo el mismo dominio -- el navegador nunca necesita una
# IP ni un dominio absoluto aqui. No hardcodear una IP de red local ni el
# dominio de produccion en este archivo.
VITE_API_URL=/api/v1
